{
  "name": "wiki-sticky",
  "version": "0.1.0",
  "description": "OKF knowledge bundles with dependencies",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build && npm run typecheck && npm test && node dist/cli.js lint && node dist/cli.js install --frozen",
    "wiki-sticky:lint": "wiki-sticky lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funarchy/wiki-sticky.git"
  },
  "keywords": [
    "knowledge-base",
    "okf",
    "wiki",
    "agents",
    "documentation",
    "markdown"
  ],
  "author": "Funarchy contributors",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/funarchy/wiki-sticky/issues"
  },
  "homepage": "https://github.com/funarchy/wiki-sticky#readme",
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "bin": {
    "wiki-sticky": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "schemas",
    "templates",
    "skills",
    ".claude-plugin",
    "wiki",
    "wiki-sticky.yaml"
  ]
}
